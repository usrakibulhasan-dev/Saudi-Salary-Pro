# GEMINI_API_KEY: Optional/Configured via AI Studio Secrets for AI Payslip OCR & Letter Drafting.
# Manual salary slip entry and deterministic bilingual letter templates work even without this key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used by server.ts to sign HMAC-SHA256 authentication tokens.
SESSION_SECRET="change-this-to-a-long-random-production-secret"

# OPTIONAL EXTERNAL CLOUD DATABASE (PostgreSQL / Supabase)
# By default, server.ts persists user-isolated data on the server filesystem (.data/saudi_salary_pro_v2.json).
DATABASE_URL=""

# OPTIONAL GOOGLE DRIVE OAUTH 2.0 BACKUP INTEGRATION
# Required only for live Google Drive OAuth backup/restore. Local JSON/XLSX/CSV backup works without keys.
VITE_GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
